<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.recopied.app</id>
  <name>Recopied</name>
  <summary>Linux clipboard manager with Win+V shortcut</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Recopied is a clipboard manager for Linux that brings the familiar Win+V
      clipboard history experience from Windows 11. Press Win+V to open a
      popup showing your recent clipboard items — text and images — and click
      to paste instantly.
    </p>
    <p>Key features:</p>
    <ul>
      <li>Win+V global shortcut to open clipboard history popup</li>
      <li>Stores text and image clipboard items in a local SQLite database</li>
      <li>Configurable clipboard history limit (default: 20 items)</li>
      <li>Full-text search across clipboard history</li>
      <li>System tray icon for quick access and settings</li>
      <li>Works on X11 and Wayland</li>
      <li>Lightweight — built with Tauri (Rust + WebKit)</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.recopied.app.desktop</launchable>

  <url type="homepage">https://github.com/mrbeandev/Recopied</url>
  <url type="bugtracker">https://github.com/mrbeandev/Recopied/issues</url>
  <url type="vcs-browser">https://github.com/mrbeandev/Recopied</url>

  <developer id="com.github.mrbeandev">
    <name>mrbeandev</name>
  </developer>

  <categories>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>clipboard</keyword>
    <keyword>clipboard manager</keyword>
    <keyword>copy paste</keyword>
    <keyword>history</keyword>
  </keywords>

  <screenshots>
